# Copy to .env.local and adjust. Never commit .env.local.
# Base URL of the FilesMagic Security Engine API (no trailing slash needed).
# Inlined into the browser bundle at build time: it is public, never put secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SECURITY_ENGINE_URL=http://localhost:8000

# Server-only secrets (route handlers in app/api/). Generate them as described in the README,
# section "Access control". Never prefix these with NEXT_PUBLIC_.
LAB_ADMIN_PASSWORD_HASH=
LAB_SESSION_SECRET=
LAB_SCAN_TOKEN_PRIVATE_KEY=
