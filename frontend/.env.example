# Copy to .env.local and adjust. Never commit .env.local.
# Public browser-side URL for the FilesMagic Security Engine API.
NEXT_PUBLIC_SECURITY_ENGINE_URL=http://localhost:8000

# Server-only Ed25519 private key for short-lived, single-use, file-bound scan tokens.
# Generate the key pair as described in README.md. Never prefix with NEXT_PUBLIC_.
LAB_SCAN_TOKEN_PRIVATE_KEY=
